# Hypercarry recording host configuration.
#
# Install to /etc/hypercarry/hypercarry.env (root-owned, 0644). This file holds
# no credentials and must never acquire any: every unit below reads public
# market data only. A key on this host would put a trading capability on a
# machine whose whole purpose is that it cannot trade.

# Hyperliquid deployment. Never defaulted implicitly by the CLI.
HYPERCARRY_NETWORK=mainnet

# Dataset root. Must be on storage that survives reboot and instance
# replacement — on EC2, a separate EBS volume mounted here.
HYPERCARRY_DATASET=/var/lib/hypercarry/data

# Coins the backfill timer keeps current, comma-delimited, no spaces.
# Each coin is a separate hourly backfill invocation.
HYPERCARRY_COINS=BTC,ETH

# Hours of settled history each routine backfill re-requests. This is a
# self-healing window, not a lookback: any gap shorter than this is repaired
# without operator action. Raising it costs one larger request per hour.
HYPERCARRY_BACKFILL_DAYS=2

# --- Health thresholds (deploy/bin/hypercarry-health-check) ---

# Age of the newest settlement, in seconds, before the dataset is stale.
# Funding settles hourly, so anything under two hours is normal; the default
# tolerates one missed settlement plus publication delay.
HYPERCARRY_MAX_SETTLEMENT_AGE_S=9000

# Unbroken hourly run required on every coin. The 24-hour acceptance gate.
HYPERCARRY_MIN_CONTIGUOUS_HOURS=24

# Free space on the dataset filesystem, in mebibytes, before alerting.
HYPERCARRY_MIN_FREE_MIB=2048

# --- Optional: live market recording (hypercarry-record.service) ---
#
# NOT required for carry P&L. Settled funding comes from backfill alone; the
# recorder captures live L2 book and asset-context frames for basis and
# prediction work. It writes orders of magnitude more data than backfill — size
# the volume and set retention before enabling it.

# Bounded normalization queue. Frames dropped under pressure stay in raw capture.
HYPERCARRY_QUEUE_CAPACITY=1024

# Days of raw recorder sessions to retain. Empty or 0 disables pruning and keeps
# every session forever. Raw JSONL is the replay source of truth: pruning it
# discards the ability to rebuild the normalized layer for those days.
HYPERCARRY_RAW_RETENTION_DAYS=
